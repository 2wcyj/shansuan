# Examples only. Inject real values using the cloud platform's secret manager.
# Never place these credentials in VITE_* variables or static hosting settings.
APP_ENV=production
FRONTEND_ORIGINS=https://app.example.cn
SESSION_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Huawei Cloud RDS for PostgreSQL (PostgreSQL protocol, asyncpg driver).
# Use sslmode=require once the RDS instance has SSL enabled.
DATABASE_URL=postgresql+asyncpg://RUNTIME_USER:REPLACE_PASSWORD@RDS_HOST:5432/shansuan?sslmode=require
# Migration role only; used by alembic and admin bootstrap, never by the app runtime.
MIGRATION_DATABASE_URL=postgresql+asyncpg://MIGRATION_USER:REPLACE_PASSWORD@RDS_HOST:5432/shansuan?sslmode=require

# Huawei Cloud DCS for Redis. Use rediss:// when SSL is enabled on the instance.
# Omit REDIS_URL to fall back to PostgreSQL sessions and rate limiting.
REDIS_URL=rediss://:REPLACE_PASSWORD@DCS_HOST:6379/0

# Huawei Cloud KMS. KMS_PROVIDER=huawei is required in production.
KMS_PROVIDER=huawei
KMS_REGION_ID=cn-north-4
KMS_KEY_ID=REPLACE_WITH_CONCRETE_HUAWEI_CLOUD_KMS_KEY_ID
HUAWEI_CLOUD_PROJECT_ID=REPLACE_WITH_PROJECT_ID
HUAWEI_CLOUD_ACCESS_KEY_ID=REPLACE_WITH_AK
HUAWEI_CLOUD_SECRET_ACCESS_KEY=REPLACE_WITH_SK
# Set only when temporary credentials from an agency are used.
# HUAWEI_CLOUD_SECURITY_TOKEN=

# Huawei Cloud OBS. Leave OBS_PROVIDER empty to disable photo APIs.
OBS_PROVIDER=huawei
OBS_REGION_ID=cn-north-4
OBS_BUCKET=REPLACE_WITH_PRIVATE_UNVERSIONED_OBS_BUCKET

# Optional Huawei Cloud model API (OpenAI-compatible endpoint from the
# ModelArts Studio "API access" page). Leave these commented out to disable
# cloud Q&A and photo recognition; manual records keep working.
# MODEL_BASE_URL=https://REPLACE_WITH_MAAS_ENDPOINT/v1
# MODEL_API_KEY=REPLACE_WITH_API_KEY
# MODEL_NAME=REPLACE_WITH_MODEL_NAME
# MODEL_VISION_NAME=REPLACE_WITH_VISION_MODEL_NAME
# MODEL_TIMEOUT=60

# Optional: password reset email through any STARTTLS SMTP endpoint.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=
# PASSWORD_RESET_URL=https://app.example.cn/reset

# Never place cloud/database credentials in VITE_* or Netlify variables.